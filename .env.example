# Copy to .env. The SITE settings (marked below) have no default: replace each placeholder
# with your own path, or the run won't start and names what is missing. Every other line
# shows its default and is optional.
# A variable set in the environment wins over this file. Relative paths are relative to
# this folder.

# --- sda-cli ---------------------------------------------------------------------------
# SDA_CLI=./sda-cli
# The run refuses to start on any other version: flags changed between releases.
# SDA_CLI_VERSION=0.3.5
# SITE: the download conf from your REMS login.
# SDA_CONFIG=/path/to/secrets/s3cmd-download.conf
# DOWNLOAD_URLS="https://download.bp.nbis.se"
# API_VERSION=v1

# --- keys ------------------------------------------------------------------------------
# SITE: your Crypt4GH public key; the private key sits beside it as <name>.sec.pem.
# PUBLIC_KEY=/path/to/secrets/mykey.pub.pem
# Empty: derived from PUBLIC_KEY by replacing .pub.pem with .sec.pem.
# PRIVATE_KEY=
# A mode-600 file holding the private key's passphrase. C4GH_PASSWORD in the environment
# wins over it. Never put the passphrase itself in this file.
# SITE (unless C4GH_PASSWORD is set):
# C4GH_PASSWORD_FILE=/path/to/secrets/c4gh-pass

# --- where things go ---------------------------------------------------------------------
# SITE: one folder per dataset, with its logs in <dataset>/_download/.
# DATASETS_ROOT=/path/to/datasets
# Off by default (empty). Set it to a mount point and the run won't start unless that is
# mounted. Turn it on when DATASETS_ROOT is on a network mount with `nofail`: a failed
# mount would otherwise make downloads fill the local disk.
# REQUIRE_MOUNT=
# SITE: keep on local disk: SQLite locking is not safe over CIFS.
# STATUS_DB=/path/to/state/status.db

# --- limits ------------------------------------------------------------------------------
# Files per `sda-cli download` call. Each call stops at its first failed file.
# DOWNLOAD_BATCH_SIZE=50
# Files per `sda-cli decrypt` call.
# DECRYPT_BATCH_SIZE=500
# A file is abandoned after this many failures, counted across runs.
# MAX_FILE_FAILURES=5
# A dataset is given up for this run after this many failed calls in a row.
# MAX_CONSECUTIVE_FAILURES=10
# Endpoint switches per dataset on `unexpected EOF`.
# MAX_ENDPOINT_SWITCHES=3
# Listing attempts per endpoint on transient errors.
# LISTING_ATTEMPTS=3
# Backoff in seconds: BASE_SLEEP, doubling per failure, capped at MAX_SLEEP.
# BASE_SLEEP=30
# MAX_SLEEP=600
# The run stops when this many hours have passed, cutting short a call in progress.
# MAX_RUNTIME_HOURS=72
# Keep this many GB (10^9 bytes) free on the share, for whatever else it holds. The
# run won't start below it, skips a dataset that won't fit, and stops before a batch would
# eat into it.
# MIN_FREE_GB=1000
# Write the status table to this CSV at the end of every run, however it ends. It is also
# the status database's only backup. Empty: don't.
# EXPORT_CSV=
# Stop this many hours before the download token expires, between calls. A new token
# needs a manual login with MFA.
# TOKEN_MARGIN_HOURS=6
